<?xml version="1.0" encoding="utf-8"?>
<!-- ویجت متوسط روتین پلنر: عادت‌های امروز + پیشرفت. چیدمان فقط با نماهای مجازِ RemoteViews. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mark"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/streak_box"
                android:layout_width="wrap_content"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/streak_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp">

                    <ImageView
                        android:id="@+id/flame"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/row1"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginTop="6dp">

                <ImageView
                    android:id="@+id/row1_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp">

                    <ImageView
                        android:id="@+id/row1_check"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/row1_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="9dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/row1_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/row1_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/row2"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginTop="6dp">

                <ImageView
                    android:id="@+id/row2_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp">

                    <ImageView
                        android:id="@+id/row2_check"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/row2_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="9dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/row2_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/row2_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/row3"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginTop="6dp">

                <ImageView
                    android:id="@+id/row3_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp">

                    <ImageView
                        android:id="@+id/row3_check"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/row3_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="9dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/row3_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/row3_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/row4"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginTop="6dp">

                <ImageView
                    android:id="@+id/row4_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp">

                    <ImageView
                        android:id="@+id/row4_check"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/row4_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="9dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/row4_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/row4_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/progress_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/bar"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="5dp"
                android:scaleType="fitXY"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
